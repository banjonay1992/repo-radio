{
  "name": "repo-radio",
  "version": "0.1.0",
  "description": "Turn a git repository's history into music: a MIDI file, a JSON score and a small web player.",
  "license": "MIT",
  "author": "Nathan Cole (NAY Productions)",
  "type": "module",
  "bin": {
    "repo-radio": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "npm run build:cli && npm run build:web",
    "build:cli": "tsc -p tsconfig.build.json",
    "build:web": "vite build --config web/vite.config.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build:cli"
  },
  "keywords": [
    "git",
    "midi",
    "music",
    "sonification",
    "cli"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "globals": "^17.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
