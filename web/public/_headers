# Response headers for static hosts that read this file, such as Cloudflare Pages.
# Vite copies it into dist-web/ unchanged.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Built assets have a content hash in their names, so they can be cached for good.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
